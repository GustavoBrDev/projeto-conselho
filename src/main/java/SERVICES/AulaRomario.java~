package SERVICES;

import MODELS.ENTITY.ADMINISTRATION.Classe;
import REPOSITORIES.RomarioRepository;
import org.springframework.beans.factory.annotation.Qualifier;
import org.springframework.data.jpa.domain.Specification;
import org.springframework.data.jpa.repository.JpaRepository;
import org.springframework.stereotype.Service;
import org.springframework.data.jpa.domain.Specification;

import java.util.List;

@Service
public class AulaRomario {

    @Qualifier("romarioRepository")
    private JpaRepository<Classe, Long> repository;

    private static Specification<Classe> filtroContextoTexto ( String texto ) {
        String finalTexto = "%" + texto + "%";
        return (root, query, cb) -> {
            cb.or ( cb.like(cb.lower(root.get("acronym")), finalTexto.toLowerCase()), cb.like(cb.lower(root.get("name")), finalTexto.toLowerCase()) );
            return cb.like(cb.lower(root.get("name")), finalTexto.toLowerCase());
        };
    }

    public List<Classe> buscarComFiltro(String texto) {
        return repository.findAll(filtroContextoTexto(texto));
    }

    public static Specification<Classe> filtroContextoDescricao ( String texto ) {
        String finalTexto = "%" + texto + "%";
        return (root, query, cb) -> {
            cb.conjunction( );
            return cb.like(cb.lower(root.get("description")), finalTexto.toLowerCase());
        };
    }

    public static Specification<Classe> filtro ( String texto ) {
        return Specification.where(filtroContextoDescricao(texto)).and(filtroContextoTexto(texto));
    }


}
